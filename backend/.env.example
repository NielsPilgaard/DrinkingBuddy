DATABASE_URL=postgresql+asyncpg://drinkingbuddy:drinkingbuddy@postgres:5432/drinkingbuddy
REDIS_URL=redis://redis:6379/0
COTURN_SECRET=changeme
POSTGRES_USER=drinkingbuddy
POSTGRES_PASSWORD=drinkingbuddy
POSTGRES_DB=drinkingbuddy

OTEL_ENABLED=true
OTEL_SERVICE_NAME=drinkingbuddy-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4317

# Local dev: mailpit (docker-compose.yml), no auth needed. View sent emails at http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=noreply@drinkingbuddy.local

# HTTPS Universal Link / App Link base for magic-link auth callbacks.
# Domain must serve /.well-known/apple-app-site-association and
# /.well-known/assetlinks.json for the OS to verify the link before opening the app.
APP_UNIVERSAL_LINK_BASE=https://app.drinking-buddy.app
