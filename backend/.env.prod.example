# Prod env for docker-compose.prod.yml (see docs/deploy.md). ENVIRONMENT=production
# is pinned in the compose file; the API refuses to start while any secret
# below is still "changeme".
DATABASE_URL=postgresql+asyncpg://drinkingbuddy:changeme@postgres:5432/drinkingbuddy
REDIS_URL=redis://redis:6379/0
COTURN_SECRET=changeme
POSTGRES_USER=drinkingbuddy
POSTGRES_PASSWORD=changeme
POSTGRES_DB=drinkingbuddy

OTEL_ENABLED=true
OTEL_SERVICE_NAME=drinkingbuddy-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4317

# Dokploy / Traefik. DNS A records for api., app. and grafana.<DOMAIN> -> VPS IP.
DOMAIN=drinking-buddy.app
GRAFANA_BASICAUTH_USERS=admin:$$apr1$$changeme$$hashedpasswordhere

# coturn public IP — required, TURN relay candidates advertise this address.
# COTURN_HOST is what the API hands clients as the STUN/TURN server address;
# keep it equal to COTURN_PUBLIC_IP.
COTURN_PUBLIC_IP=203.0.113.10
COTURN_HOST=203.0.113.10

# Scaleway Transactional Email (SMTP)
SMTP_HOST=smtp.tem.scw.cloud
SMTP_PORT=587
SMTP_USER=changeme
SMTP_PASSWORD=changeme
SMTP_USE_TLS=true
EMAIL_FROM=noreply@drinking-buddy.app

# Magic-link host, served by the API through the app.<DOMAIN> Traefik router.
# Link-verification files return 404 until these are set (tasks/16-manual-launch-steps.md):
# APPLE_TEAM_ID from the Apple Developer account; Android fingerprints from
# `npx eas-cli credentials` (plus the Play App Signing key once on Play),
# comma-separated.
APP_UNIVERSAL_LINK_BASE=https://app.drinking-buddy.app
APPLE_TEAM_ID=
ANDROID_SHA256_CERT_FINGERPRINTS=

# Didit age verification. Webhook: https://api.<DOMAIN>/verify/webhook
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=changeme
DIDIT_AGE_ESTIMATION_WORKFLOW_ID=
DIDIT_CPR_PASSTHROUGH_WORKFLOW_ID=
VERIFICATION_MONTHLY_CAP=500

# Chat safety. Generate the key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHAT_SAFETY_FLAG_ENCRYPTION_KEY=changeme
CHAT_SAFETY_MODERATION_SECRET=changeme
CHAT_SAFETY_ONCALL_EMAIL=changeme@example.com
